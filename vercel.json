{
  "version": 2,
  "builds": [
    {
      "src": "chat-app/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "chat-app/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)\\.(jpg|jpeg|png|gif|ico|svg|css|js|json|txt|woff|woff2|ttf|eot)$",
      "dest": "/$1"
    },
    {
      "src": "^/(?!api/).*$",
      "dest": "/index.html"
    }
  ],
  "rewrites": [ { "source": "/(.*)", "destination": "/chat-app/index.html" } ]
}
